# Stone (requestor) .env template — copy to the stone's working directory as
# .env and fill in the secrets. Values shown are the production settings as of
# 2026-08-27 (fleet of 10 stones, ports 6200-6209 / yagna 6100-6109).

# --- yagna (per stone; SECRET appkey) ---
YAGNA_APPKEY=<yagna app key>
YAGNA_API_URL=http://127.0.0.1:6100
YAGNA_API_BASEPATH=http://127.0.0.1:6100
YAGNA_ID=<0x... requestor node id>

# --- stone HTTP status/control API (worker count is set live through it) ---
STATUS_SERVER=http://0.0.0.0:6200

# --- provider quality thresholds (legacy local checks; the rotation ranking
#     is the main quality mechanism since 2026-08-26) ---
EFFICIENCY_LOWER_THRESHOLD=0.0125
SPEED_LOWER_THRESHOLD=125000
SPEED_ESTIMATION_TIMEFRAME=600
MINIMUM_CPU_CORES=1

# --- job source ---
JOB_UPLOADER_URL=https://addressology.net
NEW_JOB_UPLOADER_URL=http://127.0.0.1:10331/orders/webhook
PROCESSING_UNIT=cpu
OVERRIDE_PARAMS_FILE=short_params.json

# --- fleet sizing & budget ---
# NUM_WORKERS is per stone (10 stones -> 10x this many slots fleet-wide).
# Change it live with POST /workers/max/set AND here; never restart a stone
# mid-cycle just for this.
NUM_WORKERS=30
MAX_POSSIBLE_WORKERS=1000
BUDGET_LIMIT=18
SINGLE_PASS_SEC=50
COMMAND_EXECUTION_TIMEOUT_BUFFER=60000

# --- misc ---
GOLEM_PINO_LOG_LEVEL=info
NODE_VER=24.4.1

# --- common ban server (OPERATIONS.md 6b) ---
BAN_SERVER_URL=http://127.0.0.1:7710
BAN_SERVER_SOURCE=stone-0

# --- rotation scheduler (branch feat/rotation; see src/rotation_mode.ts) ---
# Defaults shown match the code; production stones run the defaults and do
# not set these explicitly. ROTATION=0 falls back to plain no-ban-pay-all.
#ROTATION=1
#ROTATION_ZERO_WORK_MINUTES=12
#ROTATION_ZERO_WORK_MIN_COST=0.02
#ROTATION_MIN_EFFICIENCY=0.0025
#ROTATION_MIN_EFF_GRACE_GLM=0.05
